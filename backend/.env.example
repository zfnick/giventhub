GCP_PROJECT=ninth-library-496500-d8
GCP_LOCATION=global

# GITEventHub AI service base URL (the separate ai-service/ FastAPI app).
# When empty — or when the service is unreachable — Workspace endpoints return
# stubs. Contract per endpoint: POST { oauth_token, prompt, files? } -> JSON.
# Local default: http://localhost:8080
AI_SERVICE_URL=

# Set to "1" to skip Firebase ID token verification during local dev.
# Never set in prod.
AUTH_DEV_BYPASS=0

# Firestore database id. Use "(default)" unless you've created a named DB.
FIRESTORE_DATABASE=(default)

# AI Studio API key. When set, Gemini calls use the Developer API instead of
# Vertex AI (separate quota — useful when Vertex is rate-limited). Leave empty
# to use Vertex AI + Application Default Credentials.
GEMINI_API_KEY=

# Neo4j AuraDB — relationship index over the playbook catalogue.
# Empty NEO4J_URI disables the Neo4j client; ecosystem chat then falls back
# to the older Gemini-only graph generation path. Get the URI/password from
# the AuraDB console after creating a free-tier instance.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
